# Enterprise Linux Access Portal - Environment Configuration
# Copy this file to .env and update the values
#
# ============================================================
# RECOMMENDED: Use AWS Secrets Manager for all sensitive values
# ============================================================
# Set AWS_SECRETS_MANAGER_ENABLED=true and store secrets in AWS.
# When enabled, sensitive values (SECRET_KEY, SESSION_SECRET_KEY,
# ENCRYPTION_KEY, EMERGENCY_ADMIN_PASSWORD, AZURE_CLIENT_SECRET,
# SMTP_PASSWORD) are loaded from AWS Secrets Manager at startup.
# Non-sensitive values (paths, ports, flags) remain in this file.
# ============================================================

# --- AWS Secrets Manager ---
# Enable to load sensitive values from AWS Secrets Manager
AWS_SECRETS_MANAGER_ENABLED=true
AWS_SECRETS_MANAGER_SECRET_NAME=linux-access-portal/config
AWS_SECRETS_MANAGER_REGION=us-east-1
# Optional: AWS CLI profile (leave empty to use EC2 instance role)
AWS_SECRETS_MANAGER_PROFILE=

# --- Application ---
APP_NAME="Enterprise Linux Access Portal"
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# SECRET_KEY, SESSION_SECRET_KEY, ENCRYPTION_KEY → stored in Secrets Manager
# If Secrets Manager is disabled, set them here:
# SECRET_KEY=generate-with-openssl-rand-hex-32
# SESSION_SECRET_KEY=generate-another-secret-key
# ENCRYPTION_KEY=generate-a-third-key

# --- Database ---
# DATABASE_URL can also be stored in Secrets Manager
DATABASE_URL=sqlite+aiosqlite:///./data/portal.db

# --- Azure AD / Microsoft Entra ID (SSO only) ---
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET → stored in Secrets Manager
AZURE_REDIRECT_URI=https://your-domain.com/api/auth/callback

# --- AD Export File ---
AD_EXPORT_PATH=/shared/ad_exports
AD_EXPORT_ENCODING=utf-8

# --- EC2 Inventory File ---
EC2_INVENTORY_PATH=/shared/ec2_inventory
EC2_INVENTORY_ENCODING=utf-8

# --- AWS Configuration (EC2 status checks) ---
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE_MAPPING=

# --- SMTP Email ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=noreply@company.com
# SMTP_PASSWORD → stored in Secrets Manager
SMTP_FROM_EMAIL=noreply@company.com
SMTP_FROM_NAME=Linux Access Portal
SMTP_USE_TLS=true

# --- SSH Configuration ---
SSH_TIMEOUT=30
SSH_RETRIES=3
SSH_RETRY_DELAY=5
SSH_CONCURRENT_LIMIT=10
SSH_KNOWN_HOSTS_FILE=

# --- Sudo Configuration ---
SUDO_VALIDITY_DAYS=90
SUDO_REMINDER_DAYS=15

# --- Session ---
SESSION_TIMEOUT_MINUTES=60

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Emergency Admin ---
EMERGENCY_ADMIN_USERNAME=admin
# EMERGENCY_ADMIN_PASSWORD → stored in Secrets Manager

# --- CORS ---
CORS_ORIGINS=https://your-domain.com
