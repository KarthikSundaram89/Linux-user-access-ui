# Enterprise Linux Access Portal - Environment Configuration
# Copy this file to .env and update the values

# Application
APP_NAME="Enterprise Linux Access Portal"
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
SECRET_KEY=generate-with-openssl-rand-hex-32

# Database (SQLite for now - can be changed to PostgreSQL later)
DATABASE_URL=sqlite+aiosqlite:///./data/portal.db

# Azure AD / Microsoft Entra ID
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_REDIRECT_URI=https://your-domain.com/api/auth/callback

# SMTP Email
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=noreply@company.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@company.com
SMTP_FROM_NAME=Linux Access Portal
SMTP_USE_TLS=true

# SSH Configuration
SSH_TIMEOUT=30
SSH_RETRIES=3
SSH_RETRY_DELAY=5
SSH_CONCURRENT_LIMIT=10

# Sudo Configuration
SUDO_VALIDITY_DAYS=90
SUDO_REMINDER_DAYS=15

# Session
SESSION_TIMEOUT_MINUTES=60
SESSION_SECRET_KEY=generate-another-secret-key

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Emergency Admin (change immediately after first login)
EMERGENCY_ADMIN_USERNAME=admin
EMERGENCY_ADMIN_PASSWORD=change-this-immediately

# CORS (comma-separated)
CORS_ORIGINS=https://your-domain.com
